<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>0.13.0.0</Version>
    <Author>ekotutar35-cyber</Author>
    <Name>KeyBrawler</Name>
    <Punchline>Read and submit one text bubble at a time.</Punchline>
    <Description>Read dedicated Keybound Brawler bubble UI text without mixing cast bars or overlapping enemies. Sequential input with color priority and optional legacy Windows OCR. Experimental.</Description>
    <RepoUrl>https://github.com/ekotutar35-cyber/keybrawler</RepoUrl>
    <Tags>ocr;accessibility;text</Tags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
